@model IEnumerable<Supermercado.Core.Models.Producto>
@{
    var carrito = ViewBag.Carrito as List<Supermercado.Core.Models.DetallePedido> ?? new List<Supermercado.Core.Models.DetallePedido>();
    decimal totalCarrito = carrito.Sum(c => c.Subtotal);
    var iconosCategoria = new Dictionary<string, string>
    {
        { "Salsas y Condimentos", "🍅" },
        { "Pastas y Granos", "🍝" },
        { "Harinas y Panadería", "🌾" },
        { "Lácteos y Huevos", "🥛" },
        { "Carnes y Embutidos", "🥩" },
        { "Verduras y Hortalizas", "🥦" },
        { "Frutas Frescas", "🍎" },
        { "Bebidas y Jugos", "🧃" },
        { "Confitería y Snacks", "🍫" }
    };
}

<style>
    .banner-catalogo {
        background: linear-gradient(120deg, #144d19 0%, #2e7d32 55%, #ef6c00 100%);
        border-radius: 24px;
        position: relative;
        overflow: hidden;
    }
    .banner-catalogo::after {
        content: "🛒";
        position: absolute;
        right: 25px;
        bottom: -15px;
        font-size: 7rem;
        opacity: 0.14;
    }
    .pill-categoria {
        border-radius: 50px;
        padding: 8px 18px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.25s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .pill-categoria:hover {
        transform: translateY(-2px);
    }
    .card-producto {
        border: 1px solid #e8f5e9;
        border-radius: 20px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        background: #ffffff;
    }
    .card-producto:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 35px rgba(27, 94, 32, 0.14) !important;
        border-color: #81c784;
    }
    .img-box-producto {
        height: 205px;
        background: radial-gradient(circle, #ffffff 60%, #f8faf8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
        border-bottom: 1px solid #f1f8e9;
    }
    .img-box-producto img {
        max-height: 175px;
        max-width: 100%;
        object-fit: cover; border-radius: 12px;
        transition: transform 0.3s ease;
    }
    .card-producto:hover .img-box-producto img {
        transform: scale(1.06);
    }
    .precio-tag {
        font-family: 'Fredoka', sans-serif;
        color: #1b5e20;
        font-size: 1.55rem;
    }
</style>

<div class="container py-4">
    <!-- Banner Superior Vibrante -->
    <div class="banner-catalogo p-4 p-md-5 mb-4 text-white shadow">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-2 fw-bold">
                    ★ Catálogo Oficial Verificado (@Model.Count() Productos Disponibles)
                </span>
                <h1 class="display-6 fw-bold mb-2">Tu Mercado Fresco en Market Express</h1>
                <p class="mb-0 opacity-90">Selecciona tus productos favoritos de nuestras marcas aliadas y recíbelos hoy mismo en tu puerta.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-action="MisPedidos" class="btn btn-light btn-lg rounded-pill fw-bold text-success shadow-sm px-4">
                        @(User.IsInRole("Admin") ? "📋 Panel Despachos FIFO" : "📦 Mis Pedidos")
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["Mensaje"] != null) { <div class="alert alert-success rounded-4 shadow-sm">@TempData["Mensaje"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger rounded-4 shadow-sm">@TempData["Error"]</div> }

    <!-- Panel Empleado/Dueño para agregar productos con foto real -->
    @if (User.IsInRole("Admin"))
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #fff8e1; border-left: 6px solid #ffa000 !important;">
            <div class="card-body">
                <h6 class="fw-bold text-dark mb-2">➕ Panel Dueño / Empleado: Agregar Nuevo Producto con Foto Real</h6>
                <form asp-action="CrearProductoReal" method="post" enctype="multipart/form-data" class="row g-2">
                    <div class="col-12 col-md-3"><input name="nombre" class="form-control form-control-sm rounded-pill" placeholder="Nombre y marca del producto" required /></div>
                    <div class="col-12 col-md-2">
                        <select name="categoria" class="form-select form-select-sm rounded-pill" required>
                            <option value="Salsas y Condimentos">🍅 Salsas y Condimentos</option>
                            <option value="Pastas y Granos">🍝 Pastas y Granos</option>
                            <option value="Lácteos y Huevos">🥛 Lácteos y Huevos</option>
                            <option value="Carnes y Embutidos">🍗 Carnes y Embutidos</option>
                            <option value="Panadería y Bebidas">🧃 Panadería y Bebidas</option>
                            <option value="Snacks y Dulces">🍫 Snacks y Dulces</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2"><input name="precio" type="number" class="form-control form-control-sm rounded-pill" placeholder="Precio ($)" required /></div>
                    <div class="col-6 col-md-1"><input name="stock" type="number" class="form-control form-control-sm rounded-pill" placeholder="Stock" required /></div>
                    <div class="col-12 col-md-3"><input name="archivoImagen" type="file" accept="image/*" class="form-control form-control-sm rounded-pill" /></div>
                    <div class="col-12 col-md-1 d-grid"><button type="submit" class="btn btn-success btn-sm rounded-pill fw-bold">Guardar</button></div>
                </form>
            </div>
        </div>
    }

    <!-- Píldoras Visuales de Categorías -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="Index" class="pill-categoria @(string.IsNullOrEmpty(ViewBag.CategoriaActual) ? "bg-success text-white shadow-sm" : "bg-white text-dark border")">
            🛒 Todos los Productos
        </a>
        @foreach (var cat in ViewBag.Categorias)
        {
            string icono = iconosCategoria.ContainsKey(cat) ? iconosCategoria[cat] : "🛍️";
            bool activa = ViewBag.CategoriaActual == cat;
            <a asp-action="Index" asp-route-categoria="@cat" class="pill-categoria @(activa ? "bg-success text-white shadow-sm" : "bg-white text-dark border")">
                <span>@icono</span> <span>@cat</span>
            </a>
        }
    </div>

    <!-- Buscador Rápido -->
    <form method="get" class="row g-2 mb-4 bg-white p-3 rounded-4 shadow-sm border">
        <input type="hidden" name="categoria" value="@ViewBag.CategoriaActual" />
        <div class="col-12 col-md-9">
            <input type="text" name="buscar" value="@ViewBag.BuscarActual" class="form-control form-control-lg border-0 bg-light rounded-pill px-4" placeholder="🔍 Busca por producto o marca (ej: Fruco, Doria, Alpina, Diana, Zenú, Bimbo...)" />
        </div>
        <div class="col-8 col-md-2 d-grid">
            <button type="submit" class="btn btn-success rounded-pill fw-bold">Buscar</button>
        </div>
        <div class="col-4 col-md-1 d-grid">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill d-flex align-items-center justify-content-center">Limpiar</a>
        </div>
    </form>

    <div class="row g-4">
        <!-- Grid de Productos -->
        <div class="col-12 @(User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") ? "col-lg-8" : "col-12")">
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-sm-6 @(User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") ? "col-xl-6" : "col-lg-4 col-xl-3")">
                        <div class="card card-producto h-100 shadow-sm overflow-hidden">
                            <div class="img-box-producto">
                                <img src="@item.ImagenUrl" alt="@item.Nombre" />
                            </div>
                            <div class="card-body d-flex flex-column p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
                                        @item.Categoria
                                    </span>
                                    <span class="badge rounded-pill bg-light text-secondary border" style="font-size: 0.75rem;">
                                        Disp: @item.Stock
                                    </span>
                                </div>
                                <h6 class="card-title fw-bold text-dark mb-1" style="min-height: 2.5rem;">@item.Nombre</h6>
                                <div class="precio-tag fw-bold mb-3">$@item.Precio.ToString("N0")</div>

                                @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && item.Stock > 0)
                                {
                                    <form asp-action="AgregarAlCarrito" method="post" class="mt-auto pt-2 border-top d-flex gap-2">
                                        <input type="hidden" name="productoId" value="@item.Id" />
                                        <input type="number" name="cantidad" value="1" min="1" max="@item.Stock" class="form-control form-control-sm rounded-pill text-center fw-bold" style="width: 68px;" required />
                                        <button type="submit" class="btn btn-success btn-sm rounded-pill flex-grow-1 fw-bold shadow-sm">
                                            + Agregar
                                        </button>
                                    </form>
                                }
                                else if (User.Identity?.IsAuthenticated != true)
                                {
                                    <a asp-controller="Cuenta" asp-action="Login" class="btn btn-outline-success btn-sm rounded-pill mt-auto fw-semibold">
                                        Inicia sesión para pedir
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Carrito Flotante del Cliente -->
        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
        {
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 sticky-top overflow-hidden" style="top: 20px;">
                    <div class="p-3 text-white fw-bold d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #1b5e20, #2e7d32);">
                        <span class="fs-5">🛒 Mi Carrito</span>
                        <span class="badge bg-warning text-dark rounded-pill px-3">@carrito.Sum(c => c.Cantidad) ítems</span>
                    </div>
                    <div class="card-body p-3">
                        @if (!carrito.Any())
                        {
                            <div class="text-center py-4 text-muted">
                                <div class="fs-1 mb-2">🛍️</div>
                                <p class="small mb-0">Tu carrito está vacío.<br />Agrega productos del catálogo para armar tu domicilio.</p>
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush mb-3" style="max-height: 260px; overflow-y: auto;">
                                @foreach (var item in carrito)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                        <div class="pe-2">
                                            <div class="fw-semibold small text-dark">@item.NombreProducto</div>
                                            <small class="text-success fw-bold">@item.Cantidad x $@item.PrecioUnitario.ToString("N0") = $@item.Subtotal.ToString("N0")</small>
                                        </div>
                                        <form asp-action="QuitarDelCarrito" method="post">
                                            <input type="hidden" name="productoId" value="@item.ProductoId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-0" title="Quitar">✕</button>
                                        </form>
                                    </li>
                                }
                            </ul>

                            <div class="d-flex justify-content-between align-items-center bg-success-subtle p-3 rounded-3 mb-3">
                                <span class="fw-bold text-dark">Total a Pagar:</span>
                                <span class="fs-4 fw-bold text-success">$@totalCarrito.ToString("N0")</span>
                            </div>

                            <form asp-action="ConfirmarPedidoCarrito" method="post">
                                <div class="mb-2">
                                    <label class="form-label small fw-bold mb-1">💳 Método de Pago:</label>
                                    <select name="metodoPago" class="form-select form-select-sm rounded-pill" required>
                                        <option value="Efectivo contra entrega">Efectivo contra entrega</option>
                                        <option value="Nequi / Daviplata">Nequi / Daviplata</option>
                                        <option value="Datáfono en casa">Datáfono (Tarjeta en casa)</option>
                                        <option value="Transferencia Bancolombia">Transferencia Bancolombia</option>
                                    </select>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold mb-1">📍 Dirección de Entrega:</label>
                                    <input type="text" name="direccion" value="@ViewBag.DireccionUsuario" class="form-control form-control-sm rounded-pill" required />
                                </div>
                                <div class="row g-1 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1">📱 WhatsApp:</label>
                                        <input type="text" name="whatsapp" value="@ViewBag.WhatsAppUsuario" class="form-control form-control-sm rounded-pill" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold mb-1">📞 Llamadas:</label>
                                        <input type="text" name="llamada" value="@ViewBag.LlamadaUsuario" class="form-control form-control-sm rounded-pill" required />
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-warning w-100 rounded-pill fw-bold py-2 shadow">
                                    🚀 Confirmar y Pedir Domicilio
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
