@model IEnumerable<Supermercado.Core.Models.Pedido>
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="fw-bold text-success">@(User.IsInRole("Admin") ? "Panel de Despachos FIFO - Market Express" : "Mis Pedidos y Seguimiento")</h2>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-success">Volver al Catálogo</a>
            @if (User.IsInRole("Admin") && ViewBag.SiguienteTurnoId != null && ViewBag.SiguienteTurnoId > 0)
            {
                <form asp-action="DespacharSiguiente" method="post">
                    <button type="submit" class="btn btn-success fw-bold shadow">
                        Despachar Siguiente Pedido (#@ViewBag.SiguienteTurnoId)
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }

    <div class="row g-3">
        @foreach (var p in Model)
        {
            bool esSiguiente = User.IsInRole("Admin") && ViewBag.SiguienteTurnoId == p.Id;
            <div class="col-12">
                <div class="card shadow-sm @(esSiguiente ? "border-success border-3" : "")">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center bg-white gap-2">
                        <div>
                            <span class="fw-bold fs-5 text-success">Pedido #@p.Id</span>
                            <span class="badge bg-dark ms-2">Llegada: @p.FechaPedido.ToString("dd/MM/yyyy HH:mm:ss")</span>
                            @if (esSiguiente) { <span class="badge bg-success ms-1">TURNO SIGUIENTE</span> }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(p.PagoConfirmado ? "bg-success" : "bg-danger") fs-6">
                                @(p.PagoConfirmado ? "💰 Pago Confirmado" : "⏳ Pago Pendiente")
                            </span>
                            <span class="badge @(p.Estado.ToString() == "Pendiente" ? "bg-warning text-dark" : (p.Estado.ToString() == "EnCamino" ? "bg-primary" : "bg-success")) fs-6">
                                @p.Estado
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <p class="mb-1"><strong>Cliente:</strong> @p.ClienteNombre</p>
                                <p class="mb-1"><strong>Dirección:</strong> <span class="text-danger fw-bold">@p.DireccionEntrega</span></p>
                                <p class="mb-1"><strong>Método de Pago:</strong> <span class="badge bg-info text-dark fs-6">@p.MetodoPago</span></p>
                                <p class="mb-1"><strong>WhatsApp:</strong> @p.TelefonoWhatsApp | <strong>Llamadas:</strong> @p.TelefonoLlamada</p>
                            </div>
                            <div class="col-md-4">
                                <strong>Detalle del Mercado:</strong>
                                @foreach (var d in p.Detalles)
                                {
                                    <div>• @d.Cantidad x @d.NombreProducto ($@d.Subtotal.ToString("N0"))</div>
                                }
                                <div class="fw-bold text-success fs-5 mt-2">Total: $@p.Total.ToString("N0")</div>

                                <!-- Botón Confirmar Recepción para el Cliente -->
                                @if (!User.IsInRole("Admin"))
                                {
                                    <div class="mt-3">
                                        @if (p.RecibidoPorCliente)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success p-2">✅ Recepción confirmada por ti</span>
                                        }
                                        else
                                        {
                                            <form asp-action="ConfirmarRecepcionCliente" method="post">
                                                <input type="hidden" name="pedidoId" value="@p.Id" />
                                                <button type="submit" class="btn btn-success btn-sm fw-bold w-100">
                                                    ✅ Confirmar que Recibí mi Pedido
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-md-3 border-start">
                                <div class="alert alert-light border p-2 small mb-2">
                                    <strong>Comunicación:</strong><br />@p.MensajeDomiciliario
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    @if (!p.PagoConfirmado)
                                    {
                                        <form asp-action="ConfirmarPagoEmpleado" method="post" class="mb-2">
                                            <input type="hidden" name="pedidoId" value="@p.Id" />
                                            <button type="submit" class="btn btn-warning btn-sm fw-bold w-100 text-dark">
                                                💰 Confirmar Pago Recibido
                                            </button>
                                        </form>
                                    }
                                    <div class="d-flex gap-1 mb-2">
                                        <a href="https://wa.me/@p.TelefonoWhatsApp?text=Hola%20@p.ClienteNombre,%20tu%20pedido%20#@p.Id%20de%20Market%20Express%20salió%20hacia%20@p.DireccionEntrega"
                                           target="_blank" class="btn btn-success btn-sm flex-grow-1">WhatsApp</a>
                                        <a href="tel:@p.TelefonoLlamada" class="btn btn-outline-primary btn-sm">Llamar</a>
                                    </div>
                                    <form asp-action="EnviarMensajeCliente" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="pedidoId" value="@p.Id" />
                                        <input type="text" name="mensaje" class="form-control form-control-sm" placeholder="Aviso al cliente..." required />
                                        <button type="submit" class="btn btn-dark btn-sm">Enviar</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
