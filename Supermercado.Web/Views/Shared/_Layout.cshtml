<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Market Express - Tu Supermercado de Confianza</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: 'Poppins', sans-serif; }
        h1, h2, h3, .navbar-brand { font-family: 'Fredoka', sans-serif; }
    </style>
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow" style="background: linear-gradient(90deg, #144d19, #2e7d32);">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fs-4" asp-controller="Tienda" asp-action="Bienvenida">
                    <img src="~/images/logo.png" alt="Market Express" style="height: 50px; width: auto; background: white; border-radius: 12px; padding: 3px; box-shadow: 0 2px 8px rgba(0,0,0,0.2);" />
                    <span>Market <span class="text-warning">Express</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-controller="Tienda" asp-action="Bienvenida">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-controller="Tienda" asp-action="Index">Catálogo de Productos</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Tienda" asp-action="MisPedidos">
                                    @(User.IsInRole("Admin") ? "Panel Despachos FIFO" : "Mis Pedidos")
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-white small me-2">Hola, <strong>@User.Identity.Name</strong></span>
                            <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">Cerrar Sesión</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Cuenta" asp-action="Registro" class="btn btn-outline-light btn-sm rounded-pill px-3">Registrarse</a>
                            <a asp-controller="Cuenta" asp-action="Login" class="btn btn-warning btn-sm fw-bold text-dark rounded-pill px-3 shadow-sm">Iniciar Sesión</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
